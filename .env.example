APP_NAME="Le Bon Panier"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Français du Québec ; heure de l'Est (Saint-Lin–Laurentides)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_CA
APP_TIMEZONE=America/Toronto

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En local : SQLite (database/database.sqlite). En production PlanetHoster : MySQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Hébergement mutualisé : pas de Redis ni de processus permanent.
# La file « database » est vidée par le cron (php artisan schedule:run chaque minute).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS) : SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Durée maximale (secondes) d'un passage du cron sur la file d'attente.
# 50 si le cron tourne chaque minute ; adapter si N0C impose un intervalle plus long.
QUEUE_CRON_MAX_TIME=50

# Sauvegarde quotidienne de la base (hors du dossier public). Sur PlanetHoster : /home/VOTRE_COMPTE/backups
BACKUP_PATH=
BACKUP_KEEP_DAYS=30
BACKUP_AT=03:15

# Courriels : SMTP de PlanetHoster (ex. commandes@lebonpanier.ca). En local : log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="commandes@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
